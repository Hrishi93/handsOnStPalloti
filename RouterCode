const express = require('express'); //TPM
const employeeRouter=require('./employeeRouter'); // UDM - employeeRouter
const studentRouter=require('./studentRouter'); //UDM - studentRouter

const app=express();

port = 5005;

// middleware
app.use('/employee' , employeeRouter);
app.use('/student', studentRouter);

app.get('/', (req,res)=>{
    res.send('Welcome on Front Page');
});

app.listen(port, ()=>{
    console.log(`Server is running http://localhost:${port}/`)
});


